<% /* index.ejs: the home page with the form. Data: countries, indicators, errors, form. */ %>
<%- include('partials/header') %>

<h1>Compare two countries</h1>
<p class="muted">Choose two countries, an indicator and a range of years.</p>

<% /* show the red box only if the list of errors is not empty */ %>
<% if (errors.length > 0) { %>
  <div class="error-box">
    <ul>
      <% errors.forEach(function (e) { %>
        <li><%= e %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<% /* action is where the form is sent. method POST means the data travels in the body, not in the address. */ %>
<form action="/compare" method="POST" class="card">

  <% /* the label for attribute is linked to the field id, so clicking the label selects the field */ %>
  <label for="country1">Country 1</label>
  <% /* the name is the key under which the server finds the value (req.body.country1) */ %>
  <select id="country1" name="country1">
    <option value="">-- choose a country --</option>
    <% /* one option for every country. The selected word is added when the user chose it before. */ %>
    <% countries.forEach(function (c) { %>
      <option value="<%= c.code %>" <%= form.country1 === c.code ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>

  <label for="country2">Country 2</label>
  <select id="country2" name="country2">
    <option value="">-- choose a country --</option>
    <% countries.forEach(function (c) { %>
      <option value="<%= c.code %>" <%= form.country2 === c.code ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>

  <label for="indicator">Indicator</label>
  <select id="indicator" name="indicator">
    <% /* Object.keys gives the list of indicator codes */ %>
    <% Object.keys(indicators).forEach(function (key) { %>
      <option value="<%= key %>" <%= form.indicator === key ? 'selected' : '' %>><%= indicators[key].name %></option>
    <% }) %>
  </select>

  <div class="years">
    <div>
      <label for="fromYear">From year</label>
      <% /* value shows what the user typed before, or 2000 on the first visit */ %>
      <input type="number" id="fromYear" name="fromYear" value="<%= form.fromYear || 2000 %>">
    </div>
    <div>
      <label for="toYear">To year</label>
      <input type="number" id="toYear" name="toYear" value="<%= form.toYear || 2022 %>">
    </div>
  </div>

  <button type="submit">Compare</button>
</form>

<%- include('partials/footer') %>
